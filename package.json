{
  "name": "@pgyer/cli",
  "version": "0.2.0",
  "description": "CLI and MCP server for the PGYER app distribution platform",
  "keywords": [
    "pgyer",
    "cli",
    "app",
    "distribution",
    "ipa",
    "apk",
    "hap",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "author": "PGYER Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PGYER/pgyer-cli.git"
  },
  "homepage": "https://github.com/PGYER/pgyer-cli#readme",
  "bugs": {
    "url": "https://github.com/PGYER/pgyer-cli/issues"
  },
  "type": "commonjs",
  "bin": {
    "pgyer": "dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "node --test --test-concurrency=1 --import tsx test/**/*.test.ts",
    "test:interactive": "npx tsx test/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "cac": "^6.7.14",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.14.0",
    "tsup": "^8.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3"
  }
}
