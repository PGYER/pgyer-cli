{
  "name": "@pgyer/cli",
  "version": "0.1.0",
  "description": "CLI tool for PGYer app distribution platform",
  "keywords": [
    "pgyer",
    "cli",
    "app",
    "distribution",
    "ipa",
    "apk",
    "hap"
  ],
  "author": "PGYER Team",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "pgyer": "dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "node --test --import tsx test/**/*.test.ts",
    "test:interactive": "npx tsx test/run.ts",
    "typecheck": "tsc --noEmit",
    "publish": "npm publish --access public"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3"
  }
}